OPENAI_API_KEY=
GEMINI_API_KEY=

# Local VietOCR (receipt OCR) — https://github.com/pbcquoc/vietocr
VIETOCR_ENABLED=true
VIETOCR_MODEL=vgg_seq2seq
VIETOCR_DEVICE=
VIETOCR_MAX_IMAGE_WIDTH=1600

# Local Ollama — LLM classify (qwen3). Not used for OCR.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_LLM_TIMEOUT_SECONDS=120
OLLAMA_VL_MODEL=qwen3-vl:4b
OLLAMA_VL_TIMEOUT_SECONDS=600
OLLAMA_VL_MAX_EDGE_PX=1280
OLLAMA_TIMEOUT_SECONDS=600
# VietOCR text → Ollama qwen3 structure. Qwen-VL off (VietOCR only for reading image).
OCR_LLM_STRUCT_ENABLED=true
OCR_LLM_VISION_FALLBACK=false

# Phase 2: FCM push
FCM_ENABLED=false
FIREBASE_CREDENTIALS_PATH=

# Phase 2: sentence-transformer embeddings
USE_SENTENCE_EMBEDDINGS=false

# Phase 3: Vintern-1B self-host (optional OCR fallback)
VINTERN_API_URL=
VINTERN_API_KEY=
VINTERN_MODEL_NAME=vintern-1b

# Phase 3: Gmail OAuth (iOS email parsing)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/email/oauth/callback

# Phase 4: GPU cost optimization & community graph
SMART_TRACK_TARGET_PCT=25.0
COMMUNITY_MIN_DISTINCT_USERS=3
