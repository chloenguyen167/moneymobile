OPENAI_API_KEY=
GEMINI_API_KEY=

# Phase 2: FCM push
FCM_ENABLED=false
FIREBASE_CREDENTIALS_PATH=

# Phase 2: sentence-transformer embeddings
USE_SENTENCE_EMBEDDINGS=false

# Phase 3: Vintern-1B (Transformers pipeline — khuyến nghị)
# pip install -r backend/requirements-ocr.txt
VINTERN_MODEL_ID=5CD-AI/Vintern-1B-v3_5
VINTERN_USE_LOCAL_PIPELINE=true

# Tuỳ chọn: Vintern HTTP API (Modal/vLLM) thay vì pipeline local
VINTERN_API_URL=
VINTERN_API_KEY=
VINTERN_MODEL_NAME=vintern-1b

# Phase 3: Gmail OAuth (iOS email parsing)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/email/oauth/callback

# Phase 4: GPU cost optimization & community graph
SMART_TRACK_TARGET_PCT=25.0
COMMUNITY_MIN_DISTINCT_USERS=3
